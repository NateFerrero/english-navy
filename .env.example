# Backend configuration for The English Navy API.
# Copy to .env for local use, or set these as Environment Variables in Vercel.

# ---------------------------------------------------------------------------
# Database provider: "turso" (production) or "local" (dev, no credentials).
# Defaults to "turso" when TURSO_API_TOKEN is set, otherwise "local".
# ---------------------------------------------------------------------------
# DB_PROVIDER=turso

# --- Turso Platform API (used to provision each user's own database) --------
# Create with: turso auth api-tokens mint english-navy
TURSO_API_TOKEN=
# Your Turso account/organization slug (turso org list / turso auth whoami).
TURSO_ORG=
# The group new per-user databases are created in (must already exist).
TURSO_GROUP=default

# --- Primary database (user accounts only) ---------------------------------
# Create once: turso db create english-navy-primary --group default
#   URL:   turso db show english-navy-primary --url
#   Token: turso db tokens create english-navy-primary
TURSO_PRIMARY_DB_URL=
TURSO_PRIMARY_DB_AUTH_TOKEN=

# --- Auth -------------------------------------------------------------------
# Secret used to sign stateless session tokens. Use a long random value.
AUTH_SECRET=

# --- Local provider only ----------------------------------------------------
# Directory for local libSQL files when DB_PROVIDER=local.
# LOCAL_DATA_DIR=.data
